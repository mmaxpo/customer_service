{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-terra",
  "small_model": "openai/gpt-5.6-luna",
  "default_agent": "decide",
  "subagent_depth": 1,
  "share": "disabled",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "permission": {
    "external_directory": "deny",
    "edit": "ask",
    "bash": "ask"
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".venv/**",
      "htmlcov/**",
      ".pytest_cache/**",
      ".ruff_cache/**",
      "**/__pycache__/**"
    ]
  }
}
